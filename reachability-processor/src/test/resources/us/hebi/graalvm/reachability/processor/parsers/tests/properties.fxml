<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane stylesheets="@custom.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nonexisting.Controller">
   <columnConstraints>
      <ColumnConstraints hgrow="NEVER" />
   </columnConstraints>
   <children>
      <Button fx:id="cell" onAction="#handle" style="-fx-padding: 10;" text="a > b" GridPane.vgrow="ALWAYS">
         <alignment>CENTER</alignment>
      </Button>
      <ButtonBar buttonOrder="L_HE+U+FBIX_NCYOA_R" />
      <javafx.scene.control.Slider snapToTicks="true" />
   </children>
</GridPane>
